                            "enum": ["present", "excused", "unexcused"]
                          },
                          "notes": {
                            "type": "string",
                            "maxLength": 1000,
                            "default": "",
                            "description": "Optional. At most 300 characters after trimming."
                          },
                          "id": {
                            "type": "integer"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
