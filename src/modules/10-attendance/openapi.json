    "/api/statistics": {
      "get": {
        "summary": "Read attendance and participation statistics",
        "description": "Read attendance and participation statistics. Local classroom prototype. Use fictional IDs only.",
        "operationId": "getStatistics",
        "tags": ["Attendance module"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["statistics"],
                  "properties": {
                    "statistics": {
                      "type": "object",
                      "required": [
                        "present",
                        "excused",
                        "unexcused",
                        "totalMarks",
                        "presentRate",
                        "participationEntries",
                        "participationPoints",
                        "averageScore"
                      ],
                      "properties": {
                        "present": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "excused": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "unexcused": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "totalMarks": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "participationEntries": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "participationPoints": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "presentRate": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100,
                          "description": "100 * present / totalMarks, rounded to 2 decimal places. 0 for no attendance marks. Includes excused marks in denominator."
                        },
                        "averageScore": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 5,
                          "description": "Participation points / entries, rounded to 2 decimals. 0 for no entries."
